<Page x:Class="Same_Energy_AdminWPF.mainmenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Same_Energy_AdminWPF"
      mc:Ignorable="d"
      Title="Same Energy Admin Panel"
      Background="#080808"
      Foreground="#FFFFFF"
      d:DesignHeight="900"
      d:DesignWidth="1500">

    <Page.Resources>

        <!-- Alap színek -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#080808"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="CardBrush" Color="#111111"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#252525"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#9C8060"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#3C3024"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8C8C8C"/>

        <!-- Menü gomb -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3,0,3"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#181818"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Akciógomb -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#171717"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3C3024"/>
                    <Setter Property="BorderBrush" Value="#9C8060"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0B0B0B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#252525"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#202020"/>
            <Setter Property="VerticalGridLinesBrush" Value="#202020"/>
            <Setter Property="RowBackground" Value="#0D0D0D"/>
            <Setter Property="AlternatingRowBackground" Value="#111111"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderBrush" Value="#252525"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
        </Style>

    </Page.Resources>


    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ====================================================== -->
        <!-- BAL OLDALI SIDEBAR -->
        <!-- ====================================================== -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#1C1C1C"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>


                <!-- LOGÓ -->
                <StackPanel Grid.Row="0"
                            Margin="25,25,20,10">

                    <TextBlock Text="SAME"
                               FontFamily="Georgia"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="ENERGY"
                               FontFamily="Georgia"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>

                    <TextBlock Text="ADMIN PANEL"
                               FontSize="9"
                               Foreground="#666666"
                               Margin="2,5,0,0"/>

                </StackPanel>


                <!-- MENÜ -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden">

                    <StackPanel Margin="12,20,12,0">

                        <TextBlock Text="MENU"
                                   Foreground="#555555"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="18,0,0,10"/>


                        <!-- Dashboard -->
                        <Button Content="  DASHBOARD"
                                Style="{StaticResource MenuButtonStyle}"/>


                        <!-- Products -->
                        <Button x:Name="productsbtn"
                                Content="  PRODUCTS"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="productsbtn_Click"/>


                        <!-- Orders -->
                        <Button x:Name="Orders"
                                Content="  ORDERS"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="Orders_Click"/>


                        <!-- Ordered Items -->
                        <Button x:Name="oderderd_item"
                                Content="  ORDERED ITEMS"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="oderderd_item_Click"/>


                        <!-- Users -->
                        <Button x:Name="userbtn"
                                Content="  USERS"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="userbtn_Click"/>


                        <Border Height="1"
                                Background="#222222"
                                Margin="18,20,18,20"/>


                        <TextBlock Text="SYSTEM"
                                   Foreground="#555555"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="18,0,0,10"/>


                        <!-- Kilépés -->
                        <Button x:Name="exitbtn"
                                Content="  EXIT"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="exitbtn_Click"/>

                    </StackPanel>

                </ScrollViewer>


                <!-- OLDAL ALJA -->
                <StackPanel Grid.Row="2"
                            Margin="25,10">

                    <Border Height="1"
                            Background="#222222"
                            Margin="0,0,0,15"/>

                    <TextBlock Text="SAME ENERGY"
                               Foreground="#666666"
                               FontSize="11"/>

                    <TextBlock Text="Administration System"
                               Foreground="#444444"
                               FontSize="10"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>

        </Border>



        <!-- ====================================================== -->
        <!-- JOBB OLDALI FŐ TARTALOM -->
        <!-- ====================================================== -->

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="35,30,35,35">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ================================================== -->
                <!-- FEJLÉC -->
                <!-- ================================================== -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,30">

                    <StackPanel>

                        <TextBlock Text="Dashboard"
                                   FontFamily="Georgia"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock Text="Manage your Same Energy store"
                                   Foreground="#777777"
                                   FontSize="13"
                                   Margin="0,7,0,0"/>

                    </StackPanel>


                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#111111"
                            BorderBrush="#252525"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="15,9">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#9C8060"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>

                            <TextBlock Text="SYSTEM ONLINE"
                                       Foreground="#999999"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>



                <!-- ================================================== -->
                <!-- STATISZTIKA KÁRTYÁK -->
                <!-- ================================================== -->

                <Grid Grid.Row="1"
                      Margin="0,0,0,30">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- Products -->
                    <Border Grid.Column="0"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="0,0,10,0"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="PRODUCTS"
                                       Foreground="#777777"
                                       FontSize="10"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="totalproductDB" Text="—"
                                       FontFamily="Georgia"
                                       FontSize="30"
                                       Foreground="White"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Products in database"
                                       Foreground="#555555"
                                       FontSize="11"/>

                        </StackPanel>

                    </Border>


                    <!-- Orders -->
                    <Border Grid.Column="1"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="5,0"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="ORDERS"
                                       Foreground="#777777"
                                       FontSize="10"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="totalordersDB" Text="—"
                                       FontFamily="Georgia"
                                       FontSize="30"
                                       Foreground="White"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Total orders"
                                       Foreground="#555555"
                                       FontSize="11"/>

                        </StackPanel>

                    </Border>


                    <!-- Users -->
                    <Border Grid.Column="2"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="5,0"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="USERS"
                                       Foreground="#777777"
                                       FontSize="10"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="totalusersDB" Text="—"
                                       FontFamily="Georgia"
                                       FontSize="30"
                                       Foreground="White"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Registered users"
                                       Foreground="#555555"
                                       FontSize="11"/>

                        </StackPanel>

                    </Border>


                    <!-- Revenue -->
                    <Border Grid.Column="3"
                            Background="{StaticResource AccentDarkBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="10,0,0,0"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="STORE"
                                       Foreground="#B8A48C"
                                       FontSize="10"
                                       FontWeight="Bold"/>

                            <TextBlock Text="ACTIVE"
                                       FontFamily="Georgia"
                                       FontSize="27"
                                       Foreground="White"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Same Energy webshop"
                                       Foreground="#8E7963"
                                       FontSize="11"/>

                        </StackPanel>

                    </Border>

                </Grid>



                <!-- ================================================== -->
                <!-- FŐ TARTALOM + JOBB OLDALI MŰVELETEK -->
                <!-- ================================================== -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>


                    <!-- ================================================== -->
                    <!-- ADATTÁBLA -->
                    <!-- ================================================== -->

                    <Border Grid.Column="0"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="0,0,20,0"
                            Padding="20">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <!-- Tábla fejléc -->
                            <Grid Grid.Row="0"
                                  Margin="0,0,0,18">

                                <StackPanel>

                                    <TextBlock Text="DATABASE"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="Store Data"
                                               FontFamily="Georgia"
                                               FontSize="23"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>


                            <!-- AKCIÓGOMBOK -->
                            <WrapPanel Grid.Row="1"
                                       Margin="0,0,0,15">

                                <Button x:Name="newprod"
                                        Content="＋  New Product"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="Hidden"
                                        Click="newprod_Click"/>

                                <Button x:Name="updtprod"
                                        Content="✎  Update Product"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="Hidden"
                                        Click="updtprod_Click"/>

                                <Button x:Name="delprod"
                                        Content="✕  Delete Product"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="Hidden"
                                        Click="delprod_Click"/>

                                <Button x:Name="updorders"
                                        Content="↻  Update Order"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="Hidden"
                                        Click="updorders_Click"/>

                            </WrapPanel>


                            <!-- DATAGRID -->
                            <DataGrid x:Name="maindg"
                                      AutoGenerateColumns="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      Margin="0,58,0,246"
                                      d:ItemsSource="{d:SampleData ItemCount=6}" Grid.RowSpan="3"/>

                        </Grid>

                    </Border>



                    <!-- ================================================== -->
                    <!-- JOBB OLDALI MŰVELETEK -->
                    <!-- ================================================== -->

                    <Border Grid.Column="1"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="22">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,-13,0,235">

                            <StackPanel>

                                <TextBlock Text="ACTIONS"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Manage"
                                           FontFamily="Georgia"
                                           FontSize="23"
                                           Foreground="White"
                                           Margin="0,4,0,25"/>



                                <!-- ====================================== -->
                                <!-- TERMÉK NÉV -->
                                <!-- ====================================== -->

                                <TextBlock x:Name="newnameprod"
                                           Text="Name:"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Visibility="Hidden"/>

                                <TextBox x:Name="newprodnametext"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Visibility="Hidden"/>



                                <!-- ====================================== -->
                                <!-- LEÍRÁS -->
                                <!-- ====================================== -->

                                <TextBlock x:Name="newproddesc"
                                           Text="Description:"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Visibility="Hidden"/>

                                <TextBox x:Name="newproddesctext"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Height="70"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Visibility="Hidden"/>



                                <!-- ====================================== -->
                                <!-- ÁR -->
                                <!-- ====================================== -->

                                <TextBlock x:Name="newprodprice"
                                           Text="Price:"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Visibility="Hidden"/>

                                <TextBox x:Name="newprodpricetext"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Visibility="Hidden"/>



                                <!-- ====================================== -->
                                <!-- MÉRET -->
                                <!-- ====================================== -->

                                <TextBlock x:Name="newprodsize"
                                           Text="Size:"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Visibility="Hidden"/>

                                <TextBox x:Name="newprodsizetext"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Visibility="Hidden"/>



                                <!-- ====================================== -->
                                <!-- KÉSZLET -->
                                <!-- ====================================== -->

                                <TextBlock x:Name="newprodstock"
                                           Text="Stock:"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Visibility="Hidden"/>

                                <TextBox x:Name="newprodstocktext"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Visibility="Hidden"/>



                                <!-- ====================================== -->
                                <!-- KATEGÓRIA -->
                                <!-- ====================================== -->

                                <TextBlock x:Name="newprodcategory"
                                           Text="Category:"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Visibility="Hidden"/>

                                <TextBox x:Name="newprodcategorytext"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Visibility="Hidden"/>



                                <!-- ====================================== -->
                                <!-- KÉP -->
                                <!-- ====================================== -->

                                <TextBlock x:Name="newprodimage"
                                           Text="Image:"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Visibility="Hidden"/>

                                <TextBox x:Name="newprodimagetext"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Visibility="Hidden"/>



                                <!-- ====================================== -->
                                <!-- TERMÉK HOZZÁADÁS -->
                                <!-- ====================================== -->

                                <Button x:Name="addprodbbtn"
                                        Content="ADD PRODUCT"
                                        Height="40"
                                        Background="{StaticResource AccentDarkBrush}"
                                        Foreground="White"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Margin="0,5,0,15"
                                        Visibility="Hidden"
                                        Click="addprodbbtn_Click"/>


                                <!-- ====================================== -->
                                <!-- TERMÉK FRISSÍTÉS -->
                                <!-- ====================================== -->

                                <Button x:Name="updateprod"
                                        Content="UPDATE PRODUCT"
                                        Height="40"
                                        Background="{StaticResource AccentDarkBrush}"
                                        Foreground="White"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Margin="0,5,0,15"
                                        Visibility="Hidden"
                                        Click="updateprod_Click"/>



                                <!-- ====================================== -->
                                <!-- RENDELÉS STÁTUSZ -->
                                <!-- ====================================== -->

                                <Border Height="1"
                                        Background="#252525"
                                        Margin="0,10,0,20"/>

                                <TextBlock Text="ORDER STATUS"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <TextBlock x:Name="statuspd"
                                           Text="Status:"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Visibility="Hidden"/>

                                <TextBox x:Name="statusupdttxt"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Visibility="Hidden"/>

                                <Button x:Name="updtstatusbttn"
                                        Content="UPDATE STATUS"
                                        Height="40"
                                        Background="#171717"
                                        Foreground="White"
                                        BorderBrush="#3A3A3A"
                                        BorderThickness="1"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Visibility="Hidden"
                                        Click="updtstatusbttn_Click"/>

                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                </Grid>



                <!-- ================================================== -->
                <!-- ALSÓ INFORMÁCIÓ -->
                <!-- ================================================== -->

                <Border Grid.Row="3"
                        Background="#0D0D0D"
                        BorderBrush="#1F1F1F"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,20,0,0"
                        Padding="18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="SAME ENERGY ADMINISTRATION"
                                       Foreground="#777777"
                                       FontSize="10"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Manage products, orders and users from one place."
                                       Foreground="#444444"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="ADMIN"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</Page>