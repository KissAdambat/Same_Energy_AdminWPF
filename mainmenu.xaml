<Page x:Class="Same_Energy_AdminWPF.mainmenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Same_Energy_AdminWPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="mainmenu">

    <Grid>
        <DataGrid x:Name="maindg" d:ItemsSource="{d:SampleData ItemCount=6}" Margin="0,39,400,10"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="750,10,0,0" VerticalAlignment="Top"/>
        <Button x:Name="productsbtn" Content="Products" HorizontalAlignment="Left" Margin="0,14,0,0" VerticalAlignment="Top"/>
        <Button x:Name="Oders" Content="Orders" HorizontalAlignment="Left" Margin="55,14,0,0" VerticalAlignment="Top"/>
        <Button x:Name="oderderd_item" Content="Ordered Items" HorizontalAlignment="Left" Margin="100,14,0,0" VerticalAlignment="Top"/>
        <Button x:Name="userbtn" Content="Users" HorizontalAlignment="Left" Margin="185,14,0,0" VerticalAlignment="Top"/>

    </Grid>
</Page>
